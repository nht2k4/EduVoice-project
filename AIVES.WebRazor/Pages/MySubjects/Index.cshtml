@page
@model AIVES.WebRazor.Pages.MySubjects.IndexModel
@{
    ViewData["Title"] = "Môn của tôi";
}
<h1 class="h3 mb-1">Môn của tôi</h1>
<p class="text-muted mb-4">Các môn quản trị viên đã phân công cho bạn. Bạn đổi được ngôn ngữ STT/TTS và quản lý ngân hàng câu hỏi của từng môn.</p>

@if (Model.Subjects.Count == 0)
{
    <div class="card border-0 shadow-sm card-body text-center py-5">
        <p class="mb-0">Bạn chưa được phân công môn học nào. Liên hệ quản trị viên để được phân công.</p>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã môn</th>
                        <th>Tên môn</th>
                        <th>STT</th>
                        <th>TTS</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Subjects)
                    {
                        <tr>
                            <td class="fw-semibold">@s.Code</td>
                            <td>
                                @s.Name
                                @if (!s.IsActive)
                                {
                                    <span class="badge text-bg-secondary ms-1">Đã ngừng</span>
                                }
                            </td>
                            <td><span class="lang-pill">@s.SttLanguage.ToLocaleCode()</span></td>
                            <td><span class="lang-pill">@s.TtsLanguage.ToLocaleCode()</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-page="/Language/Edit" asp-route-subjectId="@s.Id" class="btn btn-sm btn-outline-primary">Đổi ngôn ngữ</a>
                                <a asp-page="/Exams/Questions" asp-route-subjectId="@s.Id" class="btn btn-sm btn-outline-primary">Câu hỏi</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
