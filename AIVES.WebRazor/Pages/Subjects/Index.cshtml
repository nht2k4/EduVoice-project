@page
@model AIVES.WebRazor.Pages.Subjects.IndexModel
@{
    ViewData["Title"] = "Môn học";
}
<h1 class="h3 mb-1">Môn học và phân công</h1>
<p class="text-muted mb-4">Chọn một môn để phân công giảng viên, cấu hình ngôn ngữ STT/TTS và quản lý ngân hàng câu hỏi.</p>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã môn</th>
                    <th>Tên môn</th>
                    <th>STT</th>
                    <th>TTS</th>
                    <th class="text-center">Giảng viên</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Subjects)
                {
                    <tr class="@(s.IsActive ? "" : "text-muted")">
                        <td class="fw-semibold">@s.Code</td>
                        <td>@s.Name</td>
                        <td><span class="lang-pill">@s.SttLanguage.ToLocaleCode()</span></td>
                        <td><span class="lang-pill">@s.TtsLanguage.ToLocaleCode()</span></td>
                        <td class="text-center">@s.LecturerCount</td>
                        <td>
                            @if (s.IsActive)
                            {
                                <span class="badge text-bg-success">Đang mở</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Đã ngừng</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-page="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Phân công</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
