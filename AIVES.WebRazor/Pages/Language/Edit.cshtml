@page
@model AIVES.WebRazor.Pages.Language.EditModel
@{
    ViewData["Title"] = "Ngôn ngữ STT/TTS";
    var isAdmin = User.IsInRole(Roles.Admin);
}
<h1 class="h3 mb-1">Ngôn ngữ STT/TTS</h1>
<p class="text-muted mb-4">@Model.Input.SubjectCode: @Model.Input.SubjectName</p>

<div class="row">
    <div class="col-lg-6">
        <form method="post" class="card border-0 shadow-sm card-body">
            <input type="hidden" asp-for="Input.SubjectId" />
            <input type="hidden" asp-for="Input.SubjectCode" />
            <input type="hidden" asp-for="Input.SubjectName" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

            <div class="mb-3">
                <label asp-for="Input.SttLanguage" class="form-label"></label>
                <select asp-for="Input.SttLanguage" asp-items="Html.GetEnumSelectList<AppLanguage>()" class="form-select"></select>
                <div class="form-text">Dùng khi chuyển câu trả lời bằng giọng nói của sinh viên thành văn bản.</div>
            </div>
            <div class="mb-3">
                <label asp-for="Input.TtsLanguage" class="form-label"></label>
                <select asp-for="Input.TtsLanguage" asp-items="Html.GetEnumSelectList<AppLanguage>()" class="form-select"></select>
                <div class="form-text">Dùng khi giám khảo AI đọc câu hỏi thành giọng nói.</div>
            </div>

            @if (Model.Input.UpdatedAt.HasValue)
            {
                <p class="small text-muted">
                    Lần sửa gần nhất: @Model.Input.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") bởi @Model.Input.UpdatedBy
                </p>
            }

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Lưu cấu hình</button>
                @if (isAdmin)
                {
                    <a asp-page="/Subjects/Details" asp-route-id="@Model.Input.SubjectId" class="btn btn-outline-secondary">Hủy</a>
                }
                else
                {
                    <a asp-page="/MySubjects/Index" class="btn btn-outline-secondary">Hủy</a>
                }
            </div>
        </form>
    </div>
</div>
