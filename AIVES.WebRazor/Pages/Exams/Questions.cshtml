@page
@model AIVES.WebRazor.Pages.Exams.QuestionsModel
@{
    ViewData["Title"] = "Ngân hàng câu hỏi";
}
<h1 class="h3 mb-1">Ngân hàng câu hỏi</h1>
<p class="text-muted mb-4">Phiên thi vấn đáp chọn câu hỏi chính từ đây. "Ý chính" giúp giám khảo AI biết câu trả lời còn thiếu gì để hỏi xoáy.</p>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr><th>Câu hỏi</th><th>Ý chính</th><th></th></tr>
                    </thead>
                    <tbody>
                        @if (Model.Questions.Count == 0)
                        {
                            <tr><td colspan="3" class="text-center text-muted py-4">Chưa có câu hỏi nào cho môn này.</td></tr>
                        }
                        @foreach (var q in Model.Questions)
                        {
                            <tr class="@(q.IsActive ? "" : "text-muted")">
                                <td>@q.Content @if (!q.IsActive) { <span class="badge text-bg-secondary ms-1">Đã tắt</span> }</td>
                                <td class="small">@q.ExpectedPoints</td>
                                <td class="text-end">
                                    <form asp-page-handler="SetActive" asp-route-subjectId="@Model.SubjectId" method="post">
                                        <input type="hidden" name="questionId" value="@q.Id" />
                                        <input type="hidden" name="isActive" value="@(q.IsActive ? "false" : "true")" />
                                        <button type="submit" class="btn btn-sm @(q.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(q.IsActive ? "Tắt" : "Bật")</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <form asp-page-handler="Add" asp-route-subjectId="@Model.SubjectId" method="post" class="card border-0 shadow-sm card-body">
            <h2 class="h6">Thêm câu hỏi</h2>
            <div class="mb-3">
                <label asp-for="NewQuestion.Content" class="form-label small"></label>
                <textarea asp-for="NewQuestion.Content" rows="3" class="form-control" required maxlength="1000"></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="NewQuestion.ExpectedPoints" class="form-label small"></label>
                <textarea asp-for="NewQuestion.ExpectedPoints" rows="2" class="form-control" maxlength="1000"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Thêm</button>
        </form>
    </div>
</div>
