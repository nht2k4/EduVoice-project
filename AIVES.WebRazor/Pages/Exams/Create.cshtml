@page
@model AIVES.WebRazor.Pages.Exams.CreateModel
@{
    ViewData["Title"] = "Tạo phiên thi";
}
<a asp-page="Index" class="small">Quay lại danh sách phiên thi</a>
<h1 class="h3 mt-2 mb-4">Tạo phiên thi vấn đáp</h1>

<form method="post" class="card border-0 shadow-sm card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Input.SubjectId" class="form-label"></label>
            <select asp-for="Input.SubjectId" asp-items="Model.SubjectOptions" class="form-select">
                <option value="">Chọn môn học</option>
            </select>
            <span asp-validation-for="Input.SubjectId" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Title" class="form-label"></label>
            <input asp-for="Input.Title" class="form-control" />
            <span asp-validation-for="Input.Title" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.StartTime" class="form-label"></label>
            <input asp-for="Input.StartTime" type="datetime-local" class="form-control"
                   min="@Model.MinStartTime" max="@Model.MaxStartTime" />
            <span asp-validation-for="Input.StartTime" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.SlotMinutes" class="form-label"></label>
            <input asp-for="Input.SlotMinutes" class="form-control" />
            <span asp-validation-for="Input.SlotMinutes" class="text-danger small"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Input.MainQuestionCount" class="form-label"></label>
            <input asp-for="Input.MainQuestionCount" class="form-control" />
            <span asp-validation-for="Input.MainQuestionCount" class="text-danger small"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Input.MaxFollowUps" class="form-label"></label>
            <input asp-for="Input.MaxFollowUps" class="form-control" />
            <span asp-validation-for="Input.MaxFollowUps" class="text-danger small"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Input.MaxFollowUpsPerQuestion" class="form-label"></label>
            <input asp-for="Input.MaxFollowUpsPerQuestion" class="form-control" />
            <span asp-validation-for="Input.MaxFollowUpsPerQuestion" class="text-danger small"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Input.AnswerSeconds" class="form-label"></label>
            <input asp-for="Input.AnswerSeconds" class="form-control" />
            <span asp-validation-for="Input.AnswerSeconds" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label asp-for="Input.StudentList" class="form-label"></label>
            <textarea asp-for="Input.StudentList" rows="6" class="form-control font-monospace" placeholder="SE180001; Nguyễn Văn A&#10;SE180002; Trần Thị B"></textarea>
            <div class="form-text">Mỗi sinh viên được xếp một khung giờ liên tiếp theo đúng thứ tự trong danh sách. Hệ thống tự chọn bộ câu hỏi cho từng người, hai người thi liền nhau không trùng câu.</div>
            <span asp-validation-for="Input.StudentList" class="text-danger small"></span>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Tạo phiên thi</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const startInput = document.getElementById("Input_StartTime");
            if (startInput) {
                const now = new Date();
                const offset = now.getTimezoneOffset() * 60000;
                const localNow = new Date(now.getTime() - offset);
                const minIso = localNow.toISOString().slice(0, 16);
                if (!startInput.min || startInput.min < minIso) {
                    startInput.min = minIso;
                }
            }
        });
    </script>
}
