<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AIVES</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-md navbar-dark mb-4">
        <div class="container flex-wrap gap-2">
            <a class="navbar-brand fw-semibold" asp-page="/Index">AIVES</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <ul class="navbar-nav me-auto flex-row gap-3">
                    @if (User.IsInRole(Roles.Admin))
                    {
                        <li class="nav-item"><a class="nav-link" asp-page="/Subjects/Index">Môn học và phân công</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Accounts/Index">Tài khoản</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-page="/MySubjects/Index">Môn của tôi</a></li>
                    }
                    <li class="nav-item"><a class="nav-link" asp-page="/Exams/Index">Phiên thi vấn đáp</a></li>
                </ul>
                <div class="d-flex align-items-center gap-3 text-light">
                    <span class="small">
                        @User.Identity.Name
                        <span class="badge text-bg-light ms-1">@(User.IsInRole(Roles.Admin) ? "Quản trị viên" : "Giảng viên")</span>
                    </span>
                    <form asp-page="/Auth/Logout" method="post" class="m-0">
                        <button type="submit" class="btn btn-sm btn-outline-light">Đăng xuất</button>
                    </form>
                </div>
            }
        </div>
    </nav>

    <main class="container pb-5">
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
